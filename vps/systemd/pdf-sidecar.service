[Unit]
Description=PDF Sidecar - pdfplumber extraction API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pdf-sidecar
Environment="PDF_SIDECAR_SECRET=REPLACE_WITH_ACTUAL_SECRET"
Environment="PDF_MAX_PAGES=100"
Environment="PDF_MAX_BYTES=52428800"
Environment="GOOGLE_VISION_API_KEY=REPLACE_WITH_ACTUAL_KEY"
ExecStart=/opt/pdf-sidecar/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
